          "content": {
            "size": 11340,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Dashboard - Acme Portal PHP</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; margin: 0; }\n        nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\n        .brand { font-weight: bold; color: #2563eb; }\n        nav a { color: #6b7280; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }\n        nav a:hover { color: #2563eb; }\n        .content { max-width: 720px; margin: 2rem auto; padding: 0 1rem; display: grid; gap: 1rem; }\n        .card { background: white; padding: 1.5rem 2rem; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }\n        .admin-badge { background: #dc2626; color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; vertical-align: middle; margin-left: 0.5rem; }\n        .stat-row { display: flex; gap: 1rem; margin-top: 1rem; }\n        .stat { flex: 1; background: #f9fafb; padding: 1rem; border-radius: 8px; text-align: center; }\n        .stat .num { font-size: 1.4rem; font-weight: bold; color: #1f2937; }\n        .stat .label { font-size: 0.8rem; color: #6b7280; }\n        h2 { font-size: 1rem; color: #1f2937; margin: 0 0 0.8rem 0; }\n        .notif { padding: 0.5rem 0; border-bottom: 1px solid #f1f3f6; font-size: 0.9rem; color: #374151; }\n        .notif:last-child { border-bottom: none; }\n        .notif .time { color: #9ca3af; font-size: 0.78rem; }\n        .row { display: flex; gap: 1rem; align-items: center; }\n        select, button.save { padding: 0.4rem 0.8rem; border-radius: 6px; border: 1px solid #d1d5db; }\n        button.save { background: #2563eb; color: white; border: none; cursor: pointer; }\n        .muted { color: #9ca3af; font-size: 0.78rem; margin-top: 0.5rem; }\n\n        .tool-row { display: flex; gap: 0.5rem; margin-bottom: 0.8rem; }\n        .tool-row input { flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; }\n        .tool-row button { padding: 0.5rem 1rem; background: #2563eb; color: white; border: none; border-radius: 6px; cursor: pointer; }\n        textarea { width: 100%; box-sizing: border-box; min-height: 3.5rem; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; font-family: monospace; font-size: 0.8rem; margin-bottom: 0.6rem; }\n        pre { background: #f9fafb; padding: 0.8rem; border-radius: 6px; font-size: 0.8rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }\n    </style>\n</head>\n<body>\n    <nav>\n        <div class=\"brand\">ACME PORTAL</div>\n        <div>\n            <a href=\"/profile.html\" id=\"profileLink\">Profile</a>\n            <a href=\"#\" id=\"logoutLink\">Log out</a>\n        </div>\n    </nav>\n    <div class=\"content\">\n        <div class=\"card\">\n            <h1 style=\"margin:0 0 0.3rem 0;\">\n                Welcome back, <span id=\"username\">...</span>\n                <span class=\"admin-badge\" id=\"adminBadge\" style=\"display:none;\">ADMIN</span>\n            </h1>\n            <p style=\"margin:0; color:#6b7280;\">Account role: <span id=\"role\">...</span></p>\n            <p id=\"adminGreeting\" style=\"display:none; color:#dc2626; font-weight:bold;\">Hello, Admin!</p>\n            <div class=\"stat-row\">\n                <div class=\"stat\"><div class=\"num\">3</div><div class=\"label\">Open tickets</div></div>\n                <div class=\"stat\"><div class=\"num\">12</div><div class=\"label\">Messages</div></div>\n                <div class=\"stat\"><div class=\"num\">99.9%</div><div class=\"label\">Uptime</div></div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Recent notifications</h2>\n            <div id=\"notifList\"></div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Display settings</h2>\n            <div class=\"row\">\n                <select id=\"themeSelect\">\n                    <option value=\"light\">Light</option>\n                    <option value=\"dark\">Dark</option>\n                </select>\n                <button class=\"save\" id=\"saveSettings\">Save</button>\n            </div>\n            <div class=\"muted\">Stored client-side in a plain \"prefs\" cookie - never deserialized server-side.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Link preview</h2>\n            <div class=\"tool-row\">\n                <input type=\"text\" id=\"previewUrl\" placeholder=\"https://example.com\">\n                <button id=\"previewBtn\">Preview</button>\n            </div>\n            <pre id=\"previewOut\"></pre>\n        </div>\n\n        <div class=\"card\">\n            <h2>Document viewer</h2>\n            <div class=\"tool-row\">\n                <input type=\"text\" id=\"docFile\" value=\"../documents/welcome.txt\">\n                <button id=\"docBtn\">View</button>\n            </div>\n            <pre id=\"docOut\"></pre>\n        </div>\n\n        <div class=\"card\">\n            <h2>Restore preferences from backup</h2>\n            <p class=\"muted\">Paste a preferences backup blob (base64) and restore it.</p>\n            <textarea id=\"backup\" placeholder=\"loading backup...\"></textarea>\n            <button class=\"save\" id=\"restoreBtn\">Restore</button>\n            <pre id=\"restoreOut\" style=\"display:none;\"></pre>\n        </div>\n\n        <div class=\"card\">\n            <h2>Restore preferences (JSON export)</h2>\n            <p class=\"muted\">Paste a JSON preferences export and restore it.</p>\n            <textarea id=\"jsonPrefs\" placeholder=\"loading export...\"></textarea>\n            <button class=\"save\" id=\"jsonBtn\">Restore prefs</button>\n            <pre id=\"jsonOut\" style=\"display:none;\"></pre>\n        </div>\n\n        <div class=\"card\">\n            <h2>Queue backup (async)</h2>\n            <p class=\"muted\">Submit a backup blob for background processing. Returns immediately.</p>\n            <textarea id=\"asyncBlob\" placeholder=\"loading backup...\"></textarea>\n            <button class=\"save\" id=\"asyncBtn\">Queue backup</button>\n            <pre id=\"asyncOut\" style=\"display:none;\"></pre>\n        </div>\n\n        <div class=\"card\">\n            <h2>Saved cart</h2>\n            <p class=\"muted\">Your saved cart: 2 items. Check out to see the total.</p>\n            <form id=\"cartForm\">\n                <input type=\"hidden\" name=\"cart\" id=\"cartField\">\n                <button class=\"save\" type=\"submit\">Checkout</button>\n            </form>\n            <pre id=\"cartOut\" style=\"display:none;\"></pre>\n        </div>\n    </div>\n    <script>\n        if (!document.cookie.includes('ref_tag=')) {\n            var tag = encodeURIComponent('O:3:\"Tag\":1:{s:4:\"name\";s:7:\"organic\";}');\n            document.cookie = 'ref_tag=' + tag + '; path=/; max-age=' + (86400 * 30);\n        }\n\n        async function loadDashboard() {\n            var res = await fetch('/api/dashboard.php');\n            if (!res.ok) {\n                window.location.href = '/login.html';\n                return;\n            }\n            var data = await res.json();\n            document.getElementById('username').textContent = data.username;\n            document.getElementById('role').textContent = data.role;\n            if (data.role === 'admin') {\n                document.getElementById('adminBadge').style.display = 'inline';\n                document.getElementById('adminGreeting').style.display = 'block';\n            }\n        }\n\n        async function loadNotifications() {\n            var res = await fetch('/api/notifications.php');\n            var data = await res.json();\n            var list = document.getElementById('notifList');\n            list.innerHTML = data.map(function (n) {\n                return '<div class=\"notif\">' + n.message + '<div class=\"time\">' + n.time + '</div></div>';\n            }).join('');\n        }\n\n        document.getElementById('saveSettings').addEventListener('click', async function () {\n            var theme = document.getElementById('themeSelect').value;\n            await fetch('/api/settings.php', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ theme: theme, lang: 'en' })\n            });\n            alert('Settings saved.');\n        });\n\n        document.getElementById('previewBtn').addEventListener('click', async function () {\n            var url = document.getElementById('previewUrl').value;\n            var res = await fetch('/api/preview.php?url=' + encodeURIComponent(url));\n            var data = await res.json();\n            document.getElementById('previewOut').textContent = JSON.stringify(data, null, 2);\n        });\n\n        document.getElementById('docBtn').addEventListener('click', async function () {\n            var file = document.getElementById('docFile').value;\n            var res = await fetch('/api/document.php?file=' + encodeURIComponent(file));\n            var data = await res.json();\n            if (data.content) {\n                data.content = atob(data.content);\n            }\n            document.getElementById('docOut').textContent = JSON.stringify(data, null, 2);\n        });\n\n        document.getElementById('logoutLink').addEventListener('click', async function (e) {\n            e.preventDefault();\n            await fetch('/api/logout.php', { method: 'POST' });\n            window.location.href = '/login.html';\n        });\n\n        // Prefill the restore boxes with the SERVER's own export (round-trip) — the user never\n        // types serialized data by hand.\n        async function loadExports() {\n            var exp = await (await fetch('/api/export-prefs.php')).json();\n            document.getElementById('backup').value = exp.backup_b64;\n            document.getElementById('asyncBlob').value = exp.backup_b64;\n            document.getElementById('jsonPrefs').value = JSON.stringify({ backup: exp.backup });\n            var c = await (await fetch('/api/cart.php')).json();\n            document.getElementById('cartField').value = c.cart;\n        }\n\n        function wireImport(btnId, inputId, outId, url, contentType) {\n            document.getElementById(btnId).addEventListener('click', async function () {\n                var res = await fetch(url, { method: 'POST',\n                    headers: { 'Content-Type': contentType },\n                    body: document.getElementById(inputId).value });\n                var out = document.getElementById(outId);\n                out.style.display = 'block';\n                out.textContent = JSON.stringify(await res.json());\n            });\n        }\n        wireImport('restoreBtn', 'backup', 'restoreOut', '/api/import.php', 'text/plain');\n        wireImport('jsonBtn', 'jsonPrefs', 'jsonOut', '/api/restore-prefs.php', 'application/json');\n        wireImport('asyncBtn', 'asyncBlob', 'asyncOut', '/api/import-async.php', 'text/plain');\n\n        document.getElementById('cartForm').addEventListener('submit', async function (e) {\n            e.preventDefault();\n            var res = await fetch('/api/cart.php', { method: 'POST',\n                body: new URLSearchParams(new FormData(e.target)) });\n            var out = document.getElementById('cartOut');\n            out.style.display = 'block';\n            out.textContent = JSON.stringify(await res.json());\n        });\n\n        loadDashboard();\n        loadNotifications();\n        loadExports();\n    </script>\n</body>\n</html>\n"
          },
