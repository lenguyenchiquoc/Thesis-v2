          "content": {
            "size": 1962,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Profile - Acme Portal</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; margin: 0; }\n        nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\n        .brand { font-weight: bold; color: #2563eb; }\n        nav a { color: #6b7280; text-decoration: none; font-size: 0.9rem; }\n        .content { max-width: 480px; margin: 2rem auto; padding: 0 1rem; }\n        .card { background: white; padding: 2rem; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }\n        dl { margin: 0; }\n        dt { font-size: 0.78rem; color: #9ca3af; margin-top: 1rem; }\n        dd { margin: 0.1rem 0 0 0; font-size: 0.95rem; color: #1f2937; word-break: break-all; }\n    </style>\n</head>\n<body>\n    <nav>\n        <div class=\"brand\">ACME PORTAL</div>\n        <a href=\"/dashboard.html\">&larr; Back to dashboard</a>\n    </nav>\n    <div class=\"content\">\n        <div class=\"card\">\n            <h1 style=\"margin:0;\">Profile</h1>\n            <dl id=\"profileData\"></dl>\n        </div>\n    </div>\n    <script>\n        async function loadProfile() {\n            var res = await fetch('/api/profile');\n            if (!res.ok) {\n                window.location.href = '/login.html';\n                return;\n            }\n            var data = await res.json();\n            var dl = document.getElementById('profileData');\n            dl.innerHTML =\n                '<dt>Username</dt><dd>' + data.username + '</dd>' +\n                '<dt>Email</dt><dd>' + data.email + '</dd>' +\n                '<dt>Joined</dt><dd>' + data.joined + '</dd>' +\n                '<dt>Preferences</dt><dd>' + JSON.stringify(data.prefs) + '</dd>' +\n                '<dt>Referral tag</dt><dd>' + data.referral_tag + '</dd>';\n        }\n        loadProfile();\n    </script>\n</body>\n</html>\n"
          },
