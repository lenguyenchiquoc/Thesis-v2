          "content": {
            "size": 2266,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Profile - Acme Portal Node</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; margin: 0; }\n        nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\n        .brand { font-weight: bold; color: #2563eb; }\n        nav a { color: #6b7280; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }\n        .content { max-width: 560px; margin: 2rem auto; padding: 0 1rem; }\n        .card { background: white; padding: 1.5rem 2rem; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }\n        .field { padding: 0.6rem 0; border-bottom: 1px solid #f1f3f6; display: flex; justify-content: space-between; }\n        .field .k { color: #6b7280; font-size: 0.9rem; } .field .v { color: #1f2937; font-weight: 500; }\n    </style>\n</head>\n<body>\n    <nav>\n        <div class=\"brand\">ACME PORTAL · NODE</div>\n        <div><a href=\"/dashboard.html\">Dashboard</a></div>\n    </nav>\n    <div class=\"content\">\n        <div class=\"card\">\n            <h1 style=\"font-size:1.2rem; margin:0 0 1rem 0;\">Your profile</h1>\n            <div class=\"field\"><span class=\"k\">Username</span><span class=\"v\" id=\"username\">...</span></div>\n            <div class=\"field\"><span class=\"k\">Email</span><span class=\"v\" id=\"email\">...</span></div>\n            <div class=\"field\"><span class=\"k\">Joined</span><span class=\"v\" id=\"joined\">...</span></div>\n            <div class=\"field\"><span class=\"k\">Role</span><span class=\"v\" id=\"role\">...</span></div>\n        </div>\n    </div>\n    <script>\n        (async function () {\n            var res = await fetch('/api/profile');\n            if (res.status === 401) { window.location.href = '/login.html'; return; }\n            var d = await res.json();\n            document.getElementById('username').textContent = d.username || 'unknown';\n            document.getElementById('email').textContent = d.email || '';\n            document.getElementById('joined').textContent = d.joined || '';\n            document.getElementById('role').textContent = d.admin ? 'administrator' : 'user';\n        })();\n    </script>\n</body>\n</html>\n"
          },
