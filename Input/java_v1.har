          "content": {
            "size": 2570,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Sign in - Acme Portal</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }\n        .card { background: white; padding: 2.5rem; border-radius: 10px; box-shadow: 0 4px 16px rgba(0,0,0,0.08); width: 340px; }\n        .brand { font-weight: bold; font-size: 1.1rem; color: #2563eb; margin-bottom: 0.3rem; }\n        h1 { font-size: 1.3rem; margin: 0 0 1.2rem 0; color: #1f2937; }\n        input { width: 100%; padding: 0.6rem; margin-bottom: 1rem; box-sizing: border-box; border: 1px solid #d1d5db; border-radius: 4px; }\n        button { width: 100%; padding: 0.65rem; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; }\n        button:hover { background: #1d4ed8; }\n        .error { background: #fef2f2; color: #b91c1c; padding: 0.6rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem; }\n        .hint { color: #9ca3af; font-size: 0.8rem; margin-top: 1rem; text-align: center; }\n    </style>\n</head>\n<body>\n    <div class=\"card\">\n        <div class=\"brand\">ACME PORTAL</div>\n        <h1>Sign in to your account</h1>\n        <div class=\"error\" id=\"error\" style=\"display:none;\"></div>\n        <form id=\"loginForm\">\n            <input type=\"text\" id=\"username\" placeholder=\"Username\" required>\n            <input type=\"password\" id=\"password\" placeholder=\"Password\" required>\n            <button type=\"submit\">Sign in</button>\n        </form>\n        <div class=\"hint\">Test account: wiener / peter</div>\n    </div>\n    <script>\n        document.getElementById('loginForm').addEventListener('submit', async function (e) {\n            e.preventDefault();\n            var username = document.getElementById('username').value;\n            var password = document.getElementById('password').value;\n            var res = await fetch('/api/login', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ username: username, password: password })\n            });\n            var data = await res.json();\n            if (res.ok) {\n                window.location.href = '/dashboard.html';\n            } else {\n                var errEl = document.getElementById('error');\n                errEl.textContent = data.error || 'Login failed';\n                errEl.style.display = 'block';\n            }\n        });\n    </script>\n</body>\n</html>\n"
          },
