          "content": {
            "size": 13064,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Dashboard - Acme Portal</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; margin: 0; }\n        nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\n        .brand { font-weight: bold; color: #2563eb; }\n        nav a { color: #6b7280; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }\n        nav a:hover { color: #2563eb; }\n        .content { max-width: 720px; margin: 2rem auto; padding: 0 1rem; display: grid; gap: 1rem; }\n        .card { background: white; padding: 1.5rem 2rem; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }\n        .admin-badge { background: #dc2626; color: white; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.75rem; vertical-align: middle; margin-left: 0.5rem; }\n        .stat-row { display: flex; gap: 1rem; margin-top: 1rem; }\n        .stat { flex: 1; background: #f9fafb; padding: 1rem; border-radius: 8px; text-align: center; }\n        .stat .num { font-size: 1.4rem; font-weight: bold; color: #1f2937; }\n        .stat .label { font-size: 0.8rem; color: #6b7280; }\n        h2 { font-size: 1rem; color: #1f2937; margin: 0 0 0.8rem 0; }\n        .notif { padding: 0.5rem 0; border-bottom: 1px solid #f1f3f6; font-size: 0.9rem; color: #374151; }\n        .notif:last-child { border-bottom: none; }\n        .notif .time { color: #9ca3af; font-size: 0.78rem; }\n        .row { display: flex; gap: 1rem; align-items: center; }\n        select, button.save { padding: 0.4rem 0.8rem; border-radius: 6px; border: 1px solid #d1d5db; }\n        button.save { background: #2563eb; color: white; border: none; cursor: pointer; }\n        .muted { color: #9ca3af; font-size: 0.78rem; margin-top: 0.5rem; }\n\n        .tool-row { display: flex; gap: 0.5rem; margin-bottom: 0.8rem; }\n        .tool-row input { flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; }\n        .tool-row button { padding: 0.5rem 1rem; background: #2563eb; color: white; border: none; border-radius: 6px; cursor: pointer; }\n        pre { background: #f9fafb; padding: 0.8rem; border-radius: 6px; font-size: 0.8rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }\n    </style>\n</head>\n<body>\n    <nav>\n        <div class=\"brand\">ACME PORTAL</div>\n        <div>\n            <a href=\"/profile.html\" id=\"profileLink\">Profile</a>\n            <a href=\"#\" id=\"logoutLink\">Log out</a>\n        </div>\n    </nav>\n    <div class=\"content\">\n        <div class=\"card\">\n            <h1 style=\"margin:0 0 0.3rem 0;\">\n                Welcome back, <span id=\"username\">...</span>\n                <span class=\"admin-badge\" id=\"adminBadge\" style=\"display:none;\">ADMIN</span>\n            </h1>\n            <p style=\"margin:0; color:#6b7280;\">Account role: <span id=\"role\">...</span></p>\n            <p id=\"adminGreeting\" style=\"display:none; color:#dc2626; font-weight:bold;\">Hello, Admin!</p>\n            <div class=\"stat-row\">\n                <div class=\"stat\"><div class=\"num\">3</div><div class=\"label\">Open tickets</div></div>\n                <div class=\"stat\"><div class=\"num\">12</div><div class=\"label\">Messages</div></div>\n                <div class=\"stat\"><div class=\"num\">99.9%</div><div class=\"label\">Uptime</div></div>\n            </div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Recent notifications</h2>\n            <div id=\"notifList\"></div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Display settings</h2>\n            <div class=\"row\">\n                <select id=\"themeSelect\">\n                    <option value=\"light\">Light</option>\n                    <option value=\"dark\">Dark</option>\n                </select>\n                <button class=\"save\" id=\"saveSettings\">Save</button>\n            </div>\n            <div class=\"muted\">Stored client-side in a plain \"prefs\" cookie - never deserialized server-side.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Partner integration sync</h2>\n            <div class=\"tool-row\">\n                <input type=\"text\" id=\"syncPayload\" value=\"rO0ABXQABWhlbGxv\">\n                <button id=\"syncBtn\">Send</button>\n            </div>\n            <pre id=\"syncOut\"></pre>\n            <div class=\"muted\">Base64-encoded message body, forwarded as-is to the partner integration endpoint.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Notification channel</h2>\n            <div class=\"row\">\n                <select id=\"channelType\">\n                    <option value=\"email\">Email</option>\n                    <option value=\"slack\">Slack</option>\n                </select>\n                <input type=\"text\" id=\"channelTarget\" value=\"ops@acme-portal.test\" style=\"flex:1;\">\n                <button class=\"save\" id=\"webhookBtn\">Save</button>\n            </div>\n            <div id=\"webhookOut\" class=\"muted\" style=\"margin-top:0.5rem;\"></div>\n            <div class=\"muted\">Choose how you'd like to receive alerts.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Theme appearance</h2>\n            <div class=\"row\">\n                <span style=\"font-size:0.9rem; color:#374151;\">Background colour</span>\n                <input type=\"color\" id=\"themeColor\" value=\"#1f2937\">\n                <button class=\"save\" id=\"themeBtn\">Apply</button>\n            </div>\n            <div id=\"themeOut\" class=\"muted\" style=\"margin-top:0.5rem;\"></div>\n            <div class=\"muted\">Personalise your dashboard background.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Plugin configuration</h2>\n            <div class=\"row\">\n                <span style=\"font-size:0.9rem; color:#374151;\">Plugin profile</span>\n                <input type=\"text\" id=\"pluginName\" value=\"default\" style=\"flex:1;\">\n                <button class=\"save\" id=\"pluginBtn\">Load</button>\n            </div>\n            <div id=\"pluginOut\" class=\"muted\" style=\"margin-top:0.5rem;\"></div>\n            <div class=\"muted\">Load a saved plugin configuration profile.</div>\n        </div>\n\n        <div class=\"card\">\n            <h2>Saved cart</h2>\n            <p class=\"muted\">Your saved cart: 2 items. Check out to see the total.</p>\n            <form id=\"cartForm\">\n                <input type=\"hidden\" name=\"cart\" id=\"cartField\">\n                <button class=\"save\" type=\"submit\">Checkout</button>\n            </form>\n            <pre id=\"cartOut\" style=\"display:none;\"></pre>\n        </div>\n    </div>\n    <script>\n        if (!document.cookie.includes('ref_tag=')) {\n            var tag = encodeURIComponent('O:3:\"Tag\":1:{s:4:\"name\";s:7:\"organic\";}');\n            document.cookie = 'ref_tag=' + tag + '; path=/; max-age=' + (86400 * 30);\n        }\n\n        async function loadDashboard() {\n            var res = await fetch('/api/dashboard');\n            if (!res.ok) {\n                window.location.href = '/login.html';\n                return;\n            }\n            var data = await res.json();\n            document.getElementById('username').textContent = data.username;\n            document.getElementById('role').textContent = data.role;\n            if (data.role === 'admin') {\n                document.getElementById('adminBadge').style.display = 'inline';\n                document.getElementById('adminGreeting').style.display = 'block';\n            }\n        }\n\n        async function loadNotifications() {\n            var res = await fetch('/api/notifications');\n            var data = await res.json();\n            var list = document.getElementById('notifList');\n            list.innerHTML = data.map(function (n) {\n                return '<div class=\"notif\">' + n.message + '<div class=\"time\">' + n.time + '</div></div>';\n            }).join('');\n        }\n\n        document.getElementById('saveSettings').addEventListener('click', async function () {\n            var theme = document.getElementById('themeSelect').value;\n            await fetch('/api/settings', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify({ theme: theme, lang: 'en' })\n            });\n            alert('Settings saved.');\n        });\n\n        document.getElementById('syncBtn').addEventListener('click', async function () {\n            var b64 = document.getElementById('syncPayload').value;\n            var binary = atob(b64);\n            var bytes = new Uint8Array(binary.length);\n            for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);\n            var res = await fetch('/api/integration/receive', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/x-java-serialized-object' },\n                body: bytes\n            });\n            var data = await res.json();\n            document.getElementById('syncOut').textContent = JSON.stringify(data, null, 2);\n        });\n\n        var CHANNEL_CLASSES = {\n            email: { className: 'com.webvulenv.javaapp.model.webhook.EmailChannel', field: 'address' },\n            slack: { className: 'com.webvulenv.javaapp.model.webhook.SlackChannel', field: 'webhookUrl' }\n        };\n\n        document.getElementById('channelType').addEventListener('change', function () {\n            document.getElementById('channelTarget').value =\n                this.value === 'slack' ? 'https://hooks.slack.com/services/...' : 'ops@acme-portal.test';\n        });\n\n        document.getElementById('webhookBtn').addEventListener('click', async function () {\n            var type = document.getElementById('channelType').value;\n            var target = document.getElementById('channelTarget').value;\n            var info = CHANNEL_CLASSES[type];\n            var props = {};\n            props[info.field] = target;\n\n            var body = {\n                label: type + ' alerts',\n                channel: [info.className, props]\n            };\n\n            var res = await fetch('/api/webhook/config', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify(body)\n            });\n            var data = await res.json();\n            document.getElementById('webhookOut').textContent = data.success\n                ? 'Saved: you will be notified via ' + type + '.'\n                : 'Could not save channel config.';\n        });\n\n        document.getElementById('themeBtn').addEventListener('click', async function () {\n            var color = document.getElementById('themeColor').value;\n            var body = {\n                name: 'custom',\n                background: { '@class': 'com.webvulenv.javaapp.model.theme.ColorBackground', color: color }\n            };\n            var res = await fetch('/api/theme/import', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify(body)\n            });\n            var data = await res.json();\n            if (data.success) document.body.style.background = color;\n            document.getElementById('themeOut').textContent = data.success\n                ? 'Theme applied.' : 'Could not apply theme.';\n        });\n\n        document.getElementById('pluginBtn').addEventListener('click', async function () {\n            var body = { '@type': 'java.util.HashMap', name: document.getElementById('pluginName').value, enabled: true };\n            var res = await fetch('/api/plugin/config', {\n                method: 'POST',\n                headers: { 'Content-Type': 'application/json' },\n                body: JSON.stringify(body)\n            });\n            var data = await res.json();\n            document.getElementById('pluginOut').textContent = data.success\n                ? ('Plugin loaded: ' + data.pluginType) : 'Could not load plugin config.';\n        });\n\n        document.getElementById('logoutLink').addEventListener('click', async function (e) {\n            e.preventDefault();\n            await fetch('/api/logout', { method: 'POST' });\n            window.location.href = '/login.html';\n        });\n\n        // Saved cart (same flow as php-app): the server's own export goes into the hidden field,\n        // Checkout posts it back as a urlencoded form (application/x-www-form-urlencoded).\n        async function loadCart() {\n            var c = await (await fetch('/api/cart')).json();\n            document.getElementById('cartField').value = c.cart;\n        }\n\n        document.getElementById('cartForm').addEventListener('submit', async function (e) {\n            e.preventDefault();\n            var res = await fetch('/api/cart', { method: 'POST',\n                body: new URLSearchParams(new FormData(e.target)) });\n            var out = document.getElementById('cartOut');\n            out.style.display = 'block';\n            out.textContent = JSON.stringify(await res.json());\n        });\n\n        loadDashboard();\n        loadNotifications();\n        loadCart();\n    </script>\n</body>\n</html>\n"
          },
