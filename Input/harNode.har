          "content": {
            "size": 7625,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Dashboard - Acme Portal Node</title>\n    <style>\n        body { font-family: Arial, sans-serif; background: #eef1f5; margin: 0; }\n        nav { background: white; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }\n        .brand { font-weight: bold; color: #2563eb; }\n        nav a { color: #6b7280; text-decoration: none; font-size: 0.9rem; margin-left: 1rem; }\n        nav a:hover { color: #2563eb; }\n        .content { max-width: 720px; margin: 2rem auto; padding: 0 1rem; display: grid; gap: 1rem; }\n        .card { background: white; padding: 1.5rem 2rem; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }\n        .stat-row { display: flex; gap: 1rem; margin-top: 1rem; }\n        .stat { flex: 1; background: #f9fafb; padding: 1rem; border-radius: 8px; text-align: center; }\n        .stat .num { font-size: 1.4rem; font-weight: bold; color: #1f2937; }\n        .stat .label { font-size: 0.8rem; color: #6b7280; }\n        h2 { font-size: 1rem; color: #1f2937; margin: 0 0 0.8rem 0; }\n        .notif { padding: 0.5rem 0; border-bottom: 1px solid #f1f3f6; font-size: 0.9rem; color: #374151; }\n        .notif .time { color: #9ca3af; font-size: 0.78rem; }\n        textarea { width: 100%; box-sizing: border-box; height: 60px; border: 1px solid #d1d5db; border-radius: 6px; font-family: monospace; font-size: 0.8rem; }\n        button.save { padding: 0.5rem 1rem; background: #2563eb; color: white; border: none; border-radius: 6px; cursor: pointer; margin-top: 0.5rem; }\n        pre { background: #f9fafb; padding: 0.6rem; border-radius: 6px; font-size: 0.8rem; white-space: pre-wrap; word-break: break-all; }\n        .muted { color: #9ca3af; font-size: 0.78rem; }\n    </style>\n</head>\n<body>\n    <nav>\n        <div class=\"brand\">ACME PORTAL · NODE</div>\n        <div><a href=\"/profile.html\">Profile</a><a href=\"#\" id=\"logout\">Log out</a></div>\n    </nav>\n    <div class=\"content\">\n        <div class=\"card\">\n            <h1 style=\"margin:0 0 0.3rem 0;\">Welcome back, <span id=\"username\">...</span></h1>\n            <p style=\"margin:0; color:#6b7280;\">Account role: <span id=\"role\">user</span></p>\n            <div class=\"stat-row\">\n                <div class=\"stat\"><div class=\"num\">3</div><div class=\"label\">Open tickets</div></div>\n                <div class=\"stat\"><div class=\"num\">12</div><div class=\"label\">Messages</div></div>\n                <div class=\"stat\"><div class=\"num\">99.9%</div><div class=\"label\">Uptime</div></div>\n            </div>\n        </div>\n        <div class=\"card\">\n            <h2>Recent notifications</h2>\n            <div id=\"notifList\"></div>\n        </div>\n        <div class=\"card\">\n            <h2>Restore preferences from backup</h2>\n            <p class=\"muted\">Restore your latest server-saved backup.</p>\n            <button class=\"save\" id=\"restoreBtn\">Restore</button>\n            <pre id=\"restoreOut\" style=\"display:none;\"></pre>\n        </div>\n        <div class=\"card\">\n            <h2>Import config (JSON)</h2>\n            <p class=\"muted\">Paste a JSON config export to apply your display settings.</p>\n            <textarea id=\"cfg\">{\"theme\":\"dark\",\"lang\":\"en\",\"__proto__\":{\"note\":\"demo\"}}</textarea>\n            <button class=\"save\" id=\"cfgBtn\">Import config</button>\n            <pre id=\"cfgOut\" style=\"display:none;\"></pre>\n        </div>\n        <div class=\"card\">\n            <h2>Restore preferences (JSON export)</h2>\n            <p class=\"muted\">Restore your preferences from the server-saved export.</p>\n            <button class=\"save\" id=\"prefsBtn\">Restore prefs</button>\n            <pre id=\"prefsOut\" style=\"display:none;\"></pre>\n        </div>\n        <div class=\"card\">\n            <h2>Queue backup (async)</h2>\n            <p class=\"muted\">Queue your server-saved backup for background processing.</p>\n            <button class=\"save\" id=\"asyncBtn\">Queue</button>\n            <pre id=\"asyncOut\" style=\"display:none;\"></pre>\n        </div>\n        <div class=\"card\">\n            <h2>Import plugin config (YAML)</h2>\n            <p class=\"muted\">Load your server-saved YAML plugin config; enabled hooks run on load.</p>\n            <button class=\"save\" id=\"yamlBtn\">Import YAML</button>\n            <pre id=\"yamlOut\" style=\"display:none;\"></pre>\n        </div>\n    </div>\n    <script>\n        async function loadDash() {\n            var res = await fetch('/api/dashboard');\n            if (res.status === 401) { window.location.href = '/login.html'; return; }\n            var d = await res.json();\n            document.getElementById('username').textContent = d.username || 'unknown';\n            document.getElementById('role').textContent = d.admin ? 'administrator' : 'user';\n            var list = document.getElementById('notifList');\n            (d.notifications || []).forEach(function (n) {\n                var el = document.createElement('div');\n                el.className = 'notif';\n                el.innerHTML = n.text + ' <span class=\"time\">' + n.time + '</span>';\n                list.appendChild(el);\n            });\n        }\n        // wireImport: for the visible JSON-config box (user legitimately pastes a JSON config).\n        function wireImport(btnId, inputId, outId, url) {\n            document.getElementById(btnId).addEventListener('click', async function () {\n                var res = await fetch(url, { method: 'POST',\n                    headers: { 'Content-Type': 'text/plain' },\n                    body: document.getElementById(inputId).value });\n                var out = document.getElementById(outId);\n                out.style.display = 'block';\n                out.textContent = JSON.stringify(await res.json());\n            });\n        }\n        // The serialized backup blobs are produced by the SERVER (/api/export-*), fetched here and\n        // held in memory — NEVER shown in the UI and never authored by the user. Clicking a button\n        // POSTs the server's blob back to the deserialization sink. (An attacker still tampers the\n        // POST body in transit via Burp/curl — that tampering is the vulnerability.)\n        var BLOBS = {};\n        async function loadBlob(key, url) {\n            try { BLOBS[key] = await (await fetch(url)).text(); } catch (e) {}\n        }\n        function wireRestore(btnId, blobKey, outId, url) {\n            document.getElementById(btnId).addEventListener('click', async function () {\n                var res = await fetch(url, { method: 'POST',\n                    headers: { 'Content-Type': 'text/plain' },\n                    body: BLOBS[blobKey] || '' });\n                var out = document.getElementById(outId);\n                out.style.display = 'block';\n                out.textContent = JSON.stringify(await res.json());\n            });\n        }\n        wireImport('cfgBtn', 'cfg', 'cfgOut', '/api/import-config');\n        wireRestore('restoreBtn', 'prefs', 'restoreOut', '/api/import');\n        wireRestore('prefsBtn', 'prefs', 'prefsOut', '/api/restore-prefs');\n        wireRestore('asyncBtn', 'prefs', 'asyncOut', '/api/import-async');\n        wireRestore('yamlBtn', 'yaml', 'yamlOut', '/api/import-yaml');\n        loadBlob('prefs', '/api/export-prefs');\n        loadBlob('yaml', '/api/export-yaml');\n        document.getElementById('logout').addEventListener('click', async function (e) {\n            e.preventDefault();\n            await fetch('/api/logout', { method: 'POST' });\n            window.location.href = '/login.html';\n        });\n        loadDash();\n    </script>\n</body>\n</html>\n"
          },
